        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Signature",
              "value": "={{ $env.N8N_INTERNAL_SECRET ? require('crypto').createHmac('sha256', $env.N8N_INTERNAL_SECRET).update($env.APP_URL + '/api/internal/leads/' + $('verify-1').first().json.lead.id + '/qualify').digest('hex') : '' }}"
            }
          ]
