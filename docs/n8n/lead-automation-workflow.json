    {
      "parameters": {
        "jsCode": "// Verify HMAC-SHA256 signature\nconst secret = $env.N8N_WEBHOOK_SECRET;\nif (!secret) throw new Error('N8N_WEBHOOK_SECRET not configured');\n\nconst crypto = require('crypto');\nconst rawBody = JSON.stringify($input.first().json);\nconst signature = $input.first().json.headers?.['x-signature'] ?? '';\n\nconst expected = crypto.createHmac('sha256', secret).update(rawBody).digest('hex');\n\nif (signature !== expected) {\n  throw new Error('Invalid HMAC signature');\n}\n\n$input.first().json.event === 'lead.created'\n  && $input.first().json.version === 1\n  || (function validateEvent() {\n    if ($input.first().json.event !== 'lead.created') throw new Error('Unknown event: ' + $input.first().json.event);\n    if ($input.first().json.version !== 1) throw new Error('Unsupported version: ' + $input.first().json.version);\n    return false;\n  })();\n\nreturn $input.first().json;"
      },
      "id": "verify-1",
      "name": "Verify HMAC + Validate Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
