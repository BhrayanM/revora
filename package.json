{
  "name": "ai-growth-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:communications": "node --no-warnings --conditions=react-server --experimental-strip-types scripts/verify-communication-integrations.mjs",
    "test:crm-integrations": "node --no-warnings --conditions=react-server --experimental-strip-types --import ./scripts/register-ts-paths.mjs scripts/verify-crm-integration-contracts.mjs",
    "test:google-workspace": "node --no-warnings --conditions=react-server --experimental-strip-types --import ./scripts/register-ts-paths.mjs scripts/verify-google-workspace-integration.mjs",
    "test:integration-e2e": "npm run test:crm-integrations && npm run test:integrations && npm run test:communications && npm run test:tally && npm run test:google-workspace && node --no-warnings scripts/verify-integration-e2e-audit.mjs",
    "test:integrations": "node --no-warnings --conditions=react-server --experimental-strip-types scripts/verify-automation-webhooks.mjs",
    "test:product-ux": "node --no-warnings --conditions=react-server --experimental-strip-types --import ./scripts/register-ts-paths.mjs scripts/verify-product-ux.mjs",
    "test:tally": "node --no-warnings --conditions=react-server --experimental-strip-types --import ./scripts/register-ts-paths.mjs scripts/verify-tally-integration.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "prepare": "husky",
    "release:check": "npm run typecheck && npm run lint && npm run test:integration-e2e && npm run test:product-ux && npm run build"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "openai": "^7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
