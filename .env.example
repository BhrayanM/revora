# =============================================================================
# Revora / AI Growth Platform — Environment Configuration Template
# =============================================================================
# Usage Instructions:
# 1. Copy this file to `.env` (or `.env.local` for Next.js local overrides).
# 2. Fill in the appropriate values for your environment.
# 3. NEVER commit `.env` or `.env.local` — they are gitignored.
# 4. NEVER put server-only secrets in variables with the NEXT_PUBLIC_ prefix.
# =============================================================================

# =============================================================================
# 1. CORE APPLICATION CONFIGURATION (Public — accessible in browser and server)
# =============================================================================
# Canonical application base URL.
# - Dev: http://localhost:3000
# - CI:  https://placeholder.example.com
# - Prod: https://app.yourdomain.com (MUST be HTTPS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# User-facing application branding name.
NEXT_PUBLIC_APP_NAME=Revora

# Application Environment Mode: development | test | production
NEXT_PUBLIC_APP_ENV=development

# Comma-separated list of enabled social login providers for the login/signup UI:
# Options: google, apple, azure
# Providers omitted here will be rendered as "Coming Soon" in the auth dialogs.
# Note: Actual OAuth keys for social login are set in Supabase Dashboard > Auth > Providers.
NEXT_PUBLIC_OAUTH_PROVIDERS=google

# Cloudflare Turnstile Bot Protection:
# - Dev: 1x00000000000000000000AA (Cloudflare official testing site key — always passes)
# - CI:  1x00000000000000000000AA
# - Prod: Your Cloudflare Turnstile site key (public)
# Note: The Turnstile Secret Key is configured in Supabase Dashboard > Authentication > Bot Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# =============================================================================
# 2. SUPABASE BACKEND (Database, Auth, Storage, Realtime)
# =============================================================================
# Supabase Project URL (Public)
# - Dev/Prod: https://<project-ref>.supabase.co
# - CI:       https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co

# Supabase Anonymous Client Key (Public — protected by PostgreSQL Row Level Security)
# - Dev/Prod: eyJ... (Anon Key from Supabase Dashboard > Settings > API)
# - CI:       placeholder-anon-key-for-ci
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-for-ci

# Supabase Service Role Key (SERVER-ONLY — CRITICAL SECURITY: Bypasses RLS)
# - Required for server-side user onboarding, webhook execution, and background workers.
# - NEVER expose to browser bundles or client components.
# - Dev/Prod: eyJ... (Service Role Key from Supabase Dashboard > Settings > API)
# - CI:       Not required for deterministic contract tests.
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-never-commit-real-values

# =============================================================================
# 3. AI LEAD QUALIFICATION & INSIGHTS (Server-only)
# =============================================================================
# OpenAI API Key (SERVER-ONLY)
# - Required when AI qualification or insights features are executed.
# - If omitted, AI endpoints return a safe AIConfigurationError without crashing the app.
OPENAI_API_KEY=sk-placeholder-openai-api-key-server-only

# OpenAI Model Selection (Optional, default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# 4. AUTOMATION & CREDENTIAL SECURITY (Server-only)
# =============================================================================
# Automation Retry Worker Secret (SERVER-ONLY)
# - Protects `/api/internal/integrations/retries` from unauthorized triggering.
# - Production requirement: High-entropy string with at least 32 characters.
AUTOMATION_RETRY_SECRET=placeholder-secret-min-32-chars-long-example-value

# Dedicated Credential Encryption Key (SERVER-ONLY)
# - 64-character hexadecimal string representing a 32-byte AES-256-GCM encryption key.
# - Used to encrypt third-party provider access tokens and webhook URLs in Postgres.
# - Generate with: openssl rand -hex 32
# - If unset in development, falls back to a SHA-256 derived key from SUPABASE_SERVICE_ROLE_KEY.
# - Strongly recommended for production environments.
INTEGRATION_ENCRYPTION_KEY=

# Insecure Webhook Transport Override (Development Only)
# - Allows dispatching integration webhooks to non-HTTPS targets (e.g. localhost n8n).
# - MUST be false in production (enforced in code).
ALLOW_INSECURE_INTEGRATION_WEBHOOKS=false

# =============================================================================
# 5. DISTRIBUTED RATE LIMITING (Server-only — Optional)
# =============================================================================
# Rate Limiter Implementation: memory | redis (default: memory)
# - Development/CI: memory
# - Multi-instance Production: redis (recommended via Upstash Redis)
RATE_LIMITER=memory

# Redis Connection URL (Required only if RATE_LIMITER=redis)
# - Example: rediss://default:password@us1-example.upstash.io:6379
REDIS_URL=

# =============================================================================
# 6. THIRD-PARTY OAUTH PROVIDERS (Server-only — Optional per enabled provider)
# =============================================================================
# These OAuth app credentials are only required if your organization enables
# the corresponding provider integration. The core platform runs without them.

# --- Slack OAuth App ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://app.yourdomain.com/api/integrations/slack/callback

# --- HubSpot OAuth App ---
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://app.yourdomain.com/api/integrations/hubspot/callback

# --- GoHighLevel Marketplace OAuth App ---
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=https://app.yourdomain.com/api/integrations/crm/callback
GHL_APP_VERSION_ID=

# --- Google Workspace OAuth App (Calendar & Gmail) ---
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=https://app.yourdomain.com/api/integrations/google-workspace/callback
