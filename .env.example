# =============================================================================
# AI Growth Platform — Environment Configuration
# =============================================================================
# Copy to .env and fill in values.
# NEVER commit .env — it is gitignored.
# NEVER prefix secrets with NEXT_PUBLIC_.

# =============================================================================
# APPLICATION (Public)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI Growth Platform
NEXT_PUBLIC_APP_ENV=development

# =============================================================================
# OAUTH PROVIDERS (Public — controls which social auth buttons are shown)
# =============================================================================
# Comma-separated list of enabled OAuth providers: google, apple, azure
# Provider secrets are configured in Supabase Dashboard > Authentication > Providers
# Default if unset: google
NEXT_PUBLIC_OAUTH_PROVIDERS=google

# =============================================================================
# TURNSTILE (Public site key + Secret in Supabase Dashboard)
# =============================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=         # Cloudflare Turnstile site key (public)
# Secret key goes to: Supabase Dashboard > Authentication > Bot and Abuse Protection
# NEVER put the Turnstile secret key here.

# =============================================================================
# SUPABASE (1 public + 1 secret)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SERVER-ONLY — never expose to browser

# =============================================================================
# OPENAI (Server-only)
# =============================================================================
OPENAI_API_KEY=                      # SERVER-ONLY
OPENAI_MODEL=                        # Default: gpt-4o-mini

# =============================================================================
# N8N (Server-only)
# =============================================================================
N8N_WEBHOOK_URL=                     # n8n webhook endpoint URL
N8N_WEBHOOK_SECRET=                  # HMAC-SHA256 shared secret for signing
N8N_INTERNAL_SECRET=                 # HMAC-SHA256 shared secret for internal API

# =============================================================================
# RATE LIMITER (Optional)
# =============================================================================
RATE_LIMITER=memory                  # memory | redis (default: memory)
REDIS_URL=                           # Only required if RATE_LIMITER=redis

# =============================================================================
# CRM/SLACK — Organization-scoped credentials
# =============================================================================
# These are NOT global env vars.
# Credentials are stored per-organization in the Supabase integrations table.
# Configure via: Settings → Integrations UI in the dashboard.
#
# HubSpot:   access_token (stored in integrations table, provider=hubspot)
# GoHighLevel: api_key + location_id   (stored in integrations table, provider=gohighlevel)
# Slack:     webhook_url               (stored in integrations table, provider=slack)
#
# Legacy/placeholder vars below — not used by the application:
# HUBSPOT_ACCESS_TOKEN, GHL_API_KEY, SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET, TWILIO_*, NEXTAUTH_*
