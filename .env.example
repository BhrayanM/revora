# =============================================================================
# AI Growth Platform — Environment Configuration
# =============================================================================
# Copy to .env and fill in values.
# NEVER commit .env — it is gitignored.
# NEVER prefix secrets with NEXT_PUBLIC_.

# =============================================================================
# APPLICATION (Public)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI Growth Platform
NEXT_PUBLIC_APP_ENV=development

# =============================================================================
# OAUTH PROVIDERS (Public — controls which social auth buttons are active)
# =============================================================================
# Comma-separated: google, apple, azure
# Providers NOT listed are shown as "Coming Soon" (disabled) rather than hidden.
# Provider secrets are configured in Supabase Dashboard > Authentication > Providers.
# Default if unset: google
NEXT_PUBLIC_OAUTH_PROVIDERS=google

# =============================================================================
# TURNSTILE (Public site key + Secret in Supabase Dashboard)
# =============================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=         # Cloudflare Turnstile site key (public)
# Secret key goes to: Supabase Dashboard > Authentication > Bot and Abuse Protection
# NEVER put the Turnstile secret key here.

# =============================================================================
# SUPABASE (1 public + 1 secret)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SERVER-ONLY — never expose to browser

# =============================================================================
# OPENAI (Server-only)
# =============================================================================
OPENAI_API_KEY=                      # SERVER-ONLY
OPENAI_MODEL=                        # Default: gpt-4o-mini

# =============================================================================
# AUTOMATION DELIVERY WORKER (Server-only)
# =============================================================================
AUTOMATION_RETRY_SECRET=              # Random value with at least 32 characters
ALLOW_INSECURE_INTEGRATION_WEBHOOKS=false # Development-only HTTP override

# =============================================================================
# RATE LIMITER (Optional)
# =============================================================================
RATE_LIMITER=memory                  # memory | redis (default: memory)
REDIS_URL=                           # Only required if RATE_LIMITER=redis

# =============================================================================
# CRM/SLACK — Organization-scoped credentials
# =============================================================================
# These are NOT global env vars.
# Credentials are stored per-organization in the Supabase integrations table.
# Configure via: Settings → Integrations UI in the dashboard.
#
# HubSpot:   OAuth 2.0 (see HUBSPOT_* below for server-level config)
# GoHighLevel: OAuth 2.0 (see GHL_* below for server-level config)
# Slack:     OAuth 2.0 (see SLACK_* below for server-level config)
#
# Legacy/placeholder vars below — not used by the application:
# HUBSPOT_ACCESS_TOKEN, GHL_API_KEY, SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET, TWILIO_*, NEXTAUTH_*

# =============================================================================
# HUBSPOT OAUTH (Server-only)
# =============================================================================
# Required for HubSpot OAuth 2.0 integration flow.
# Obtain from: HubSpot Developer Account > Apps > Auth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=                  # e.g. https://yourapp.com/api/integrations/hubspot/callback

# =============================================================================
# GOHIGHLEVEL OAUTH (Server-only)
# =============================================================================
# Required for GoHighLevel Marketplace OAuth 2.0 integration.
# Obtain from: GoHighLevel Marketplace > App > OAuth
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=                      # e.g. https://yourapp.com/api/integrations/crm/callback
GHL_APP_VERSION_ID=                    # Draft/Test Link only; omit once a live version exists

# =============================================================================
# SLACK OAUTH (Server-only)
# =============================================================================
# Required for Slack OAuth 2.0 with an incoming webhook channel selection.
# Obtain from: Slack API > Your Apps > OAuth & Permissions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=                    # e.g. https://yourapp.com/api/integrations/slack/callback

# =============================================================================
# INTEGRATION ENCRYPTION (Server-only)
# =============================================================================
# Optional: 64-character hex string for AES-256-GCM credential encryption.
# Falls back to a derived key from SUPABASE_SERVICE_ROLE_KEY if unset.
# Recommended for production with a dedicated key.
INTEGRATION_ENCRYPTION_KEY=
